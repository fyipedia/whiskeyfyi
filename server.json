{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fyipedia/whiskeyfyi",
  "description": "Whiskey knowledge API client — search whiskey types, distilleries, and terms from WhiskeyFYI.",
  "version": "0.1.4",
  "repository": {
    "url": "https://github.com/fyipedia/whiskeyfyi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "whiskeyfyi",
      "version": "0.1.4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "whiskeyfyi[mcp]"
        },
        {
          "type": "positional",
          "value": "python"
        },
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "whiskeyfyi.mcp_server"
        }
      ]
    }
  ]
}
